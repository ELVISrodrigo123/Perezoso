# ---------- Etapa 1: compilar ----------
FROM node:22.14.0 AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------- Etapa 2: servir ----------
FROM node:22.14.0-slim
WORKDIR /app

RUN npm install -g serve
COPY --from=build /app/build ./build

CMD ["sh", "-c", "serve -s build -l ${PORT:-3000}"]